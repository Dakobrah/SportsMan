# Dependencies and build output. app/.gitignore covers the app's own
# node_modules and dist directories; these catch anything run from the root.
node_modules/
coverage/

# Tauri build output
app/src-tauri/target/
app/src-tauri/gen/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Local Claude Code permissions -- per machine, never shared
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local nflverse play-by-play download (95MB). Nothing in the repo reads it
# any more, so it is safe to delete.
.pbp-cache/
