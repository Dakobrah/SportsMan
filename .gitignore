.Python

# Python distribution / packaging. These are build artifacts of a setuptools
# build at the repo root, so they are anchored with a leading slash. Left
# unanchored, `lib/` also matches app/src/lib/ and hides the Svelte app's
# entire core from git.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

