{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": [
      "node",
      "vite/client",
      "@testing-library/jest-dom"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
